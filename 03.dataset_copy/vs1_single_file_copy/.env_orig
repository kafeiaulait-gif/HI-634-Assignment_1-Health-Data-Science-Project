# Configuration for dataset_copy.py
# Source directory path (relative or absolute)
SOURCE_FOLDER=source_dir

# Name of the source file to copy
SOURCE_FILE=sample.txt

# Target directory path (relative or absolute)
TARGET_FOLDER=target_dir

# Rename flag: Y to rename in target folder, N to keep original name
RENAME_FILE=N

# Target file name (required only if RENAME_FILE=Y)
TARGET_FILE_NAME=renamed_sample.txt
