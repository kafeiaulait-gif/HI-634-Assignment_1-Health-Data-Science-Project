# Local test configuration
SOURCE_FOLDER=source_dir
TARGET_FOLDER=target_dir

# Semicolon-separated list of source files (includes a non-.data file to test filter)
SOURCE_FILES=processed.cleveland.data; processed.hungarian.data; processed.switzerland.data; processed.va.data; heart-disease.names

# Rename flag: Y to rename, N to keep original name
RENAME_FILE=Y

# Target file names (used if RENAME_FILE=Y)
TARGET_FILES=cleveland.data; hungarian.data; switzerland.data; va.data
