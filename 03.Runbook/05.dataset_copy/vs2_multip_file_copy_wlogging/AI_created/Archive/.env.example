# Configuration for copy_file.py
# Relative paths from 03.dataset_copy/
SOURCE_FOLDER=../source_datafiles/heart+disease
TARGET_FOLDER=../project/data/raw

# Semicolon-separated list of files to copy (or *.data for all .data files).
# The script will only copy files from this list that end in .data (skipping non-.data files).
SOURCE_FILES=processed.cleveland.data; processed.hungarian.data; processed.switzerland.data; processed.va.data

# Rename flag: Y to rename in target folder, N to keep original names
RENAME_FILE=N

# Semicolon-separated target names (required only if RENAME_FILE=Y, must match count of valid .data files)
TARGET_FILES=cleveland.data; hungarian.data; switzerland.data; va.data
